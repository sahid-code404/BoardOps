{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@modern/*": ["src/modern/*"]
    },
    "types": ["@cloudflare/workers-types", "vite/client"]
  },
  "include": [
    "src/modern/**/*.ts",
    "src/modern/**/*.tsx",
    "vite.modern.config.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-modern"]
}
